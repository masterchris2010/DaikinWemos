  updateSleepPreview();
  if (!$('sleepForm').reportValidity()) return;
  const minutes = sleepDurationMinutes();
  if (minutes < 1 || minutes > 1440) return;
  send('/api/sleep', {minutes}, 'sleepMessage');
};
