function decodeHumidityPayload(payload) {
  const bytes = String(payload || '').trim().split(/\s+/);
  if (bytes.length !== 3 || bytes.some(byte => !/^[0-9a-f]{2}$/i.test(byte))) return null;
  const digits = bytes.map(byte => String.fromCharCode(parseInt(byte,16))).reverse().join('');
  if (!/^\d{3}$/.test(digits)) return null;
  const humidity = Number(digits);
  return humidity >= 0 && humidity <= 100 ? humidity : null;
}
