struct AcState {
  bool known = false;
  bool power = false;
  char mode = '3';
  char fan = 'A';
  uint8_t rawSetpoint = 76; // 24 C, used only after a valid F1 response.
  float target = 24.0f;
  float room = NAN, outside = NAN, internalTarget = NAN;
  int fanRpm = -1;
  int8_t turbo = -1, eco = -1;
  bool swingKnown = false, swingV = false, swingH = false;
  uint32_t basicRead = 0;
};

