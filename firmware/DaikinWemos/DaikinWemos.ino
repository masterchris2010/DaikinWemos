  label.append(day);
}
function addMultiStep(step={minute:420,mode:'4',half:42,targets:[]}){
  if($('multiSteps').children.length>=6)return;
  const box=multiElement('fieldset',null,$('multiSteps'));box.className='multi-step';
  multiElement('legend','Azione',box);
  box.innerHTML+='<div class="grid"><label>Ora<input class="shared-time" type="time" required></label><label>Azione<select class="shared-mode"><option value="4">Riscaldamento</option><option value="3">Raffrescamento</option><option value="1">Automatico</option><option value="0">Spegni</option></select></label><label class="shared-temp-label">Temperatura (°C)<input class="shared-temp" type="number" min="16" max="30" step="0.5" required></label></div>';
  const time=box.querySelector('.shared-time'), mode=box.querySelector('.shared-mode'),temp=box.querySelector('.shared-temp');
  time.value=String(Math.floor(step.minute/60)).padStart(2,'0')+':'+String(step.minute%60).padStart(2,'0');
  mode.value=step.mode;temp.value=(step.half||42)/2;
  mode.onchange=()=>{temp.disabled=mode.value==='0';temp.min=mode.value==='4'?16:18;box.querySelector('.shared-temp-label').hidden=temp.disabled;};
  mode.onchange();
  function check(text,checked){
    const label=multiElement('label',null,box);label.className='check';
    const input=multiElement('input',null,label);input.type='checkbox';input.checked=checked;
    label.append(text);return input;
  }
  const all=check('Tutti',!step.targets.length);all.className='shared-all';
  const ids=new Set([...(multiState?.devices||[]).filter(d=>d.paired).map(d=>d.id),...step.targets]);
  for(const id of ids){const input=check(multiName(id),step.targets.includes(id));input.dataset.target=id;input.disabled=all.checked;}
  all.onchange=()=>{for(const input of box.querySelectorAll('[data-target]'))input.disabled=all.checked;};
  const remove=multiElement('button','Rimuovi azione',box);remove.type='button';remove.className='secondary';
  remove.onclick=()=>box.remove();
}
function editMultiPlan(plan){
  multiPlan=plan;
  const form=$('multiPlanForm');
  form.hidden=false;form.elements.name.value=plan.name;form.elements.enabled.checked=plan.enabled;
  for(const input of $('multiDays').querySelectorAll('input'))input.checked=Boolean(plan.days&Number(input.value));
  $('multiSteps').replaceChildren();for(const step of plan.steps)addMultiStep(step);
  if(!plan.steps.length)addMultiStep();
  $('multiDeletePlan').hidden=!plan.id;
  form.scrollIntoView({block:'nearest'});
}
async function loadMultiPlans(){
  const r=await multiRequest('plans');
  if(!r.ok)return;
  const data=await r.json(), list=$('multiPlans');
  list.replaceChildren();
  for(const p of data.plans){
    const li=multiElement('li',null,list), button=multiElement('button',p.name,li);
    button.type='button';button.className='secondary';
    button.onclick=()=>editMultiPlan(p);
    multiElement('small',p.steps.length+' azioni · '+(p.enabled?'attiva':'sospesa')+' · versione '+p.revision,li);
  }
  $('multiNewPlan').disabled=!multiState.ready||data.used>=data.limit;
  $('multiNewPlan').textContent='Nuova programmazione ('+data.used+'/'+data.limit+' posti usati)';
}
$('multiNewPlan').onclick=()=>editMultiPlan({id:0,creator:0,editor:0,revision:0,name:'',enabled:true,days:62,steps:[]});
$('multiCancelPlan').onclick=()=>{$('multiPlanForm').hidden=true;};
$('multiAddStep').onclick=()=>addMultiStep();
async function putMultiPlan(deleting){
  if(!multiPlan)return;
  const {id,creator,editor,revision}=multiPlan;
  const data={id,creator,editor,revision,delete:deleting?'1':'0'};
  const form=$('multiPlanForm'), status=$('multiPlanStatus');
  if(!deleting){
    data.name=form.elements.name.value.trim();data.enabled=form.elements.enabled.checked?'1':'0';
    data.days=[...$('multiDays').querySelectorAll(':checked')].reduce((days,input)=>days|Number(input.value),0);
    const steps=[...$('multiSteps').children];data.count=steps.length;
    for(const [i,box] of steps.entries()){
      const [hours,minutes]=box.querySelector('.shared-time').value.split(':').map(Number);
      data['minute'+i]=hours*60+minutes;
      const mode=box.querySelector('.shared-mode').value;
      data['mode'+i]=mode;data['half'+i]=mode==='0'?0:Number(box.querySelector('.shared-temp').value)*2;
      const all=box.querySelector('.shared-all').checked;
      const targets=[...box.querySelectorAll('[data-target]:checked')].map(input=>input.dataset.target);
      if(!all&&!targets.length){status.textContent='Seleziona almeno un destinatario per ogni azione.';return;}
      data['targets'+i]=all?'':targets.join(',');
    }
  }
  try{
    const response=await multiRequest('plans',data);
    status.textContent=await response.text();
    if(response.ok){form.hidden=true;await loadMultiPlans();}
  }catch(error){status.textContent='Salvataggio non confermato.';}
}
$('multiPlanForm').onsubmit=event=>{event.preventDefault();putMultiPlan(false);};
$('multiDeletePlan').onclick=()=>{if(confirm('Eliminare la programmazione condivisa?'))putMultiPlan(true);};
setInterval(()=>{if(multiState?.enabled||!$('panel-multi').hidden)refreshMulti();},6000);
