      $('humidityProbeResult').textContent = 'Risposta ricevuta, ma il valore di umidità non è valido.';
      return;
    }
    $('humidityProbeResult').textContent = 'Risposta del Daikin: '+humidity+'% UR. '+
      (humidity === 50 ? 'Potrebbe essere il valore fisso delle unità senza sensore: misura non confermata.' : 'Da confrontare con un igrometro per verificare la misura.');
  } catch(error) {
    $('humidityProbeResult').textContent = error.message || 'Lettura non riuscita. Verifica il debug e riprova.';
  } finally {
    busy = false;
    refresh();
  }
};

