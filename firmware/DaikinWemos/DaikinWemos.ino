  $('panel-home').classList.toggle('remote-unavailable',!online);
  if(!linked)$('connection').textContent='Unità offline';
}
$('homeUnit').onchange=()=>{
  if(busy){$('homeUnit').value=homeUnitId??'';return;}
  cancelAutoApply();
  ++controlsRevision;
  editing=fanEdited=false;
  homeUnitId=$('homeUnit').value?Number($('homeUnit').value):null;
  homeUnitName=$('homeUnit').selectedOptions[0]?.textContent || '';
  for(const id of ['message','sleepMessage','swingMessage','specialMessage'])$(id).textContent='';
  if(homeUnitId===null && lastLiveState)renderHome(lastLiveState);
  updateHomeUnit();
};
async function refreshMulti(loadPlans=false){
  if(multiLoading)return;
  multiLoading=true;
  try{
    const response=await multiRequest('devices');
    if(!response.ok)throw Error(await response.text());
    multiState=await response.json();
    multiUnavailable=false;
    updateHomeUnit();
    $('tab-multi').hidden=!multiState.enabled;
    if(!multiConfigLoaded){
      const form=$('multiConfigForm').elements;
      form.enabled.checked=multiState.enabled;
      multiState.manual.forEach((ip,i)=>form['ip'+i].value=ip);
      multiConfigLoaded=true;
    }
    if(!multiState.enabled&&!$('panel-multi').hidden)navigateTab($('tab-home'));
    if(!$('panel-multi').hidden){
      renderMulti();
      if(multiState.paired&&(loadPlans||$('multiPlanForm').hidden))await loadMultiPlans();
    }
  }catch(error){
    multiUnavailable=true;
    updateHomeUnit();
    if(!$('panel-multi').hidden)$('multiStatus').textContent='Multi-Daikin non raggiungibile. Riprovo automaticamente.';
  }finally{multiLoading=false;}
}
$('multiConfigDetails').addEventListener('toggle',()=>{if($('multiConfigDetails').open)refreshMulti();});
$('multiConfigForm').addEventListener('input',()=>{multiConfigLoaded=true;});
$('multiGenerateKey').onclick=()=>{
  const field=$('multiConfigForm').elements.key;
  field.value=Array.from(crypto.getRandomValues(new Uint8Array(32)),n=>n.toString(16).padStart(2,'0')).join('');
  field.type='text';field.select();
  $('multiConfigStatus').textContent='Copia la chiave e usala anche sulle altre schede.';
};
$('multiSetClock').onclick=async()=>{
  const admin=$('multiConfigForm').elements.admin;
  if(!admin.reportValidity())return;
  try{
    const response=await multiRequest('config',{clock:Math.floor(Date.now()/1000)},admin.value.trim());
    $('multiConfigStatus').textContent=await response.text();
    if(response.ok)admin.value='';
  }catch(error){$('multiConfigStatus').textContent='Sincronizzazione orologio non confermata.';}
};
$('multiConfigForm').onsubmit=async event=>{
  event.preventDefault();
  const form=event.currentTarget.elements;
  const data={enabled:form.enabled.checked?'1':'0',key:form.key.value.trim()};
  for(let i=0;i<7;i++)data['ip'+i]=form['ip'+i].value.trim();
  if(data.key && multiState?.paired && !confirm('Sostituire la chiave? Con una chiave diversa le programmazioni condivise appartengono a una nuova rete.'))return;
  try{
    const r=await multiRequest('config',data,form.admin.value.trim());
    $('multiConfigStatus').textContent=await r.text();
    if(r.ok){form.admin.value='';form.key.value='';form.key.type='password';multiConfigLoaded=false;await refreshMulti();}
  }catch(error){$('multiConfigStatus').textContent='Salvataggio non confermato.';}
};
function jobDescription(code){return code?multiCode[code]||('Errore '+code):'In attesa';}
async function multiJob(data,show=()=>{}){
  const response=await multiRequest('command',data);
  if(!response.ok)throw Error(await response.text());
  const {batch,jobs:initial}=await response.json();
  let jobs=initial;
  show(jobs);
  for(let i=0;i<14&&jobs.some(j=>!j.code);i++){
    await new Promise(resolve=>setTimeout(resolve,450));
    const r=await multiRequest('jobs');
    if(!r.ok)throw Error(await r.text());
    const update=await r.json();
    if(update.batch!==batch)throw Error('Un altro comando ha sostituito la lista degli esiti.');
    jobs=update.jobs;
    show(jobs);
  }
  return jobs;
}
async function sendHomeRemote(path,data,out){
  const id=homeUnitId, revision=controlsRevision;
  if(multiBusy){$(out).textContent='Attendi il comando Multi-Daikin in corso.';return;}
  const fields=Object.fromEntries(new URLSearchParams(data));
  const op={id,value:0,minutes:0};
  if(path==='/api/set'){
    Object.assign(op,{action:10,value:fields.power,mode:fields.mode.charCodeAt(0),
      fan:fields.fan?fields.fan.charCodeAt(0):0,minutes:Number(fields.temp)*2});
  }else if(path==='/api/swing'){
    Object.assign(op,{action:5,value:Number(fields.vertical)+2*Number(fields.horizontal)});
  }else if(path==='/api/sleep'){
    Object.assign(op,{action:8,minutes:fields.minutes});
  }else{
    Object.assign(op,{action:fields.feature==='turbo'?6:7,value:fields.enabled});
  }
  busy=multiBusy=true;
  $('homeUnit').disabled=true;
  $(out).textContent='Attendo la conferma di '+homeUnitName+'…';
  try{
    const jobs=await multiJob(op);
    const job=jobs.find(result=>result.id===id);
    if(homeUnitId===id)$(out).textContent=job?.code?jobDescription(job.code):'Nessuna conferma ricevuta.';
  }catch(error){
    if(homeUnitId===id)$(out).textContent='Comando non verificato. '+error.message;
  }finally{
    try {await refreshMulti();}
    finally {
      if(revision===controlsRevision){
        editing=fanEdited=false;
        updateHomeUnit();
      }
      busy=multiBusy=false;
      $('homeUnit').disabled=false;
    }
  }
}
async function runMulti(id,action,value,minutes=0){
  if(multiBusy)return;
  if(!id && !confirm('Confermi il comando per tutti i climatizzatori abbinati, incluso questo?'))return;
  multiBusy=true;
  const status=$('multiCommandStatus'),list=$('multiResults');
  status.textContent='Attendo la conferma di ogni climatizzatore…';
  list.replaceChildren();
  try{
    const jobs=await multiJob({id,action,value,minutes,confirmed:id?'0':'1'},jobs=>{
      list.replaceChildren();
      for(const j of jobs)multiElement('li',multiName(j.id)+' · '+jobDescription(j.code),list);
    });
    status.textContent=jobs.some(j=>!j.code)?'Alcune conferme sono ancora in attesa.': 'Esiti ricevuti.';
  }catch(error){status.textContent='Comando non verificato. '+error.message;}
  finally{multiBusy=false;refreshMulti();}
}
for(const button of document.querySelectorAll('[data-multi-command]'))button.onclick=()=>{
  const [action,value]=button.dataset.multiCommand.split(',').map(Number);
  if(multiSelected==null)return;
  runMulti(multiSelected,action,value);
};
$('multiAllOn').onclick=()=>runMulti(0,1,1);
$('multiAllOff').onclick=()=>runMulti(0,1,0);
$('multiCommandForm').addEventListener('input',()=>{multiFormEdited=true;});
for(const form of [$('multiCommandForm'),$('multiGlobalForm')])form.onsubmit=event=>{
  event.preventDefault();
  if(!event.submitter)return;
  const action=Number(event.submitter.value), fields=form.elements;
  const value=action===2?Number(fields.temp.value)*2:action===3?fields.mode.value.charCodeAt(0):
    action===4?fields.fan.value.charCodeAt(0):action===5?Number(fields.swing.value):0;
  runMulti(form.id==='multiGlobalForm'?0:multiSelected,action,value,action===8?Number(fields.timer.value):0);
};
for(const [i,day] of ['Dom','Lun','Mar','Mer','Gio','Ven','Sab'].entries()){
